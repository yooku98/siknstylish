// Deploy note: `firebase deploy --only storage:rules` fails on this project
// with "Could not find rules for the following storage targets: rules" --
// a firebase-tools bug unrelated to permissions (firestore.rules deploys
// fine via the same CLI). Deploy this file via the Firebase Rules REST API
// instead: create a ruleset (POST .../rulesets) then release it to
// firebase.storage/<bucket> (PATCH .../releases/firebase.storage%2F<bucket>).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isStaff() {
      return isSignedIn() && request.auth.token.role == 'staff';
    }
    // Uploads are resized client-side (lib/resizeImage.ts), so 10 MB only
    // bites on files that couldn't be decoded/resized, e.g. HEIC.
    function isImageUpload() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /portfolio/{collectionSlug}/{fileName} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    // Ownership is tagged via customMetadata.clientId at upload time (set by
    // the app), rather than a firestore.get() cross-service lookup -- that
    // was tried first but the cross-service read doesn't transparently carry
    // the client's own Firestore read permissions, so even the legitimate
    // owner was denied.
    match /orders/{orderId}/sketches/{fileName} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.metadata.clientId == request.auth.uid);
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    match /orders/{orderId}/inspiration/{fileName} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.metadata.clientId == request.auth.uid);
      allow create, update: if isImageUpload() && (isStaff() ||
        (isSignedIn() && request.resource.metadata.clientId == request.auth.uid));
      allow delete: if isStaff();
    }
  }
}
