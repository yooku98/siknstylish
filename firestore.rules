rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: Staff/admin accounts are distinguished by a custom claim role: "staff".
    // This claim must be set via the Firebase Admin SDK (e.g. admin.auth().setCustomUserClaims)
    // per staff account -- it is not configurable from the console. See scripts/set-staff-claim.mjs.
    function isSignedIn() {
      return request.auth != null;
    }
    function isStaff() {
      return isSignedIn() && request.auth.token.role == 'staff';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Lets a client claim an order staff created before they had a portal
    // account (clientId left null, matched by email at creation time).
    // Gated on email_verified so this can't be used to hijack someone
    // else's order just by knowing their email and signing up first --
    // Google sign-in is verified by Google automatically; email/password
    // sign-ups get a verification email (see AuthForm).
    function canClaimOrder(order) {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        order.clientId == null &&
        order.clientEmail == request.auth.token.email;
    }
    // The booking form is public (no sign-in required, by design -- it's
    // the pre-signup lead-capture step), so its writes can't be gated on
    // request.auth. Validate shape/size instead so it can't be used to
    // inject arbitrary fields or oversized junk into the collection.
    function isValidBookingRequest(data) {
      return data.keys().hasOnly([
        'name', 'email', 'phone', 'garmentCategory', 'consultationType',
        'preferredDate', 'preferredTime', 'notes', 'status', 'createdAt'
      ]) &&
      data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
      data.email is string && data.email.size() > 0 && data.email.size() < 200 &&
      data.phone is string && data.phone.size() < 50 &&
      data.garmentCategory is string && data.garmentCategory.size() < 100 &&
      data.consultationType is string && data.consultationType.size() < 50 &&
      data.preferredDate is string && data.preferredDate.size() < 50 &&
      data.preferredTime is string && data.preferredTime.size() < 50 &&
      data.notes is string && data.notes.size() < 2000 &&
      data.status == 'new' &&
      data.createdAt == request.time;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isStaff();
      match /measurements/{docId} {
        allow read, write: if isOwner(uid) || isStaff();
      }
    }

    match /orders/{orderId} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.clientId == request.auth.uid) ||
        canClaimOrder(resource.data);
      allow create: if isStaff();
      allow update: if isStaff() ||
        (isSignedIn() && resource.data.clientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['inspirationNotes', 'fabricApproved', 'sketchApproved', 'inspirationPhotos'])) ||
        (canClaimOrder(resource.data) &&
         request.resource.data.clientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientId', 'updatedAt']));
      allow delete: if isStaff();
    }

    match /bookingRequests/{requestId} {
      allow read, update, delete: if isStaff();
      allow create: if isValidBookingRequest(request.resource.data);
    }

    match /portfolioItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if false;
    }
  }
}
