rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: Staff/admin accounts are distinguished by a custom claim role: "staff".
    // This claim must be set via the Firebase Admin SDK (e.g. admin.auth().setCustomUserClaims)
    // per staff account -- it is not configurable from the console. See scripts/set-staff-claim.mjs.
    function isSignedIn() {
      return request.auth != null;
    }
    function isStaff() {
      return isSignedIn() && request.auth.token.role == 'staff';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Lets a client claim an order staff created before they had a portal
    // account (clientId left null, matched by email at creation time).
    // Gated on email_verified so this can't be used to hijack someone
    // else's order just by knowing their email and signing up first --
    // Google sign-in is verified by Google automatically; email/password
    // sign-ups get a verification email (see AuthForm).
    function canClaimOrder(order) {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        order.clientId == null &&
        order.clientEmail == request.auth.token.email;
    }
    // The booking form is public (no sign-in required, by design -- it's
    // the pre-signup lead-capture step), so its writes can't be gated on
    // request.auth. Validate shape/size instead so it can't be used to
    // inject arbitrary fields or oversized junk into the collection.
    function isValidBookingRequest(data) {
      return data.keys().hasOnly([
        'name', 'email', 'phone', 'garmentCategory', 'consultationType',
        'preferredDate', 'preferredTime', 'notes', 'status', 'createdAt'
      ]) &&
      data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
      data.email is string && data.email.size() > 0 && data.email.size() < 200 &&
      data.phone is string && data.phone.size() < 50 &&
      data.garmentCategory is string && data.garmentCategory.size() < 100 &&
      data.consultationType is string && data.consultationType.size() < 50 &&
      data.preferredDate is string && data.preferredDate.size() < 50 &&
      data.preferredTime is string && data.preferredTime.size() < 50 &&
      data.notes is string && data.notes.size() < 2000 &&
      data.status == 'new' &&
      data.createdAt == request.time;
    }

    // A manual entry in orders/{orderId}/payments. The same write must move
    // the order's depositPaid by exactly this amount (within half a pesewa,
    // for float rounding), and the deposit can never go negative or past
    // the total.
    function isValidManualPayment(orderId) {
      let data = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      return data.keys().hasOnly([
        'amount', 'method', 'note', 'source', 'paidAt',
        'recordedBy', 'recordedByEmail', 'processedAt'
      ]) &&
      data.amount is number && data.amount != 0 &&
      data.method in ['cash', 'momo', 'bank', 'other'] &&
      data.note is string && data.note.size() <= 300 &&
      (data.amount > 0 || data.note.size() > 0) &&
      data.source == 'manual' &&
      data.paidAt is timestamp && data.paidAt <= request.time + duration.value(1, 'd') &&
      data.recordedBy == request.auth.uid &&
      data.recordedByEmail is string &&
      data.processedAt == request.time &&
      after.lastPaymentId == request.resource.id &&
      math.abs(after.depositPaid - (before.depositPaid + data.amount)) < 0.005 &&
      after.depositPaid >= 0 &&
      after.depositPaid <= after.totalAmount;
    }
    // Staff edits that touch depositPaid must land together with a new
    // payments entry named by lastPaymentId -- no silent deposit changes.
    function changesDepositWithLogEntry(orderId) {
      let paymentPath = /databases/$(database)/documents/orders/$(orderId)/payments/$(request.resource.data.lastPaymentId);
      return request.resource.data.lastPaymentId is string &&
        !exists(paymentPath) && existsAfter(paymentPath);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isStaff();
      match /measurements/{docId} {
        allow read, write: if isOwner(uid) || isStaff();
      }
    }

    match /orders/{orderId} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.clientId == request.auth.uid) ||
        canClaimOrder(resource.data);
      allow create: if isStaff() && request.resource.data.depositPaid == 0 &&
        !('lastPaymentId' in request.resource.data);
      allow update: if (isStaff() &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['depositPaid', 'lastPaymentId']) ||
          changesDepositWithLogEntry(orderId))) ||
        (isSignedIn() && resource.data.clientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['inspirationNotes', 'fabricApproved', 'sketchApproved', 'inspirationPhotos'])) ||
        (canClaimOrder(resource.data) &&
         request.resource.data.clientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientId', 'updatedAt']));
      allow delete: if isStaff();

      // Append-only payment log. Paystack entries are written by Cloud
      // Functions (Admin SDK, bypasses rules); staff add manual ones.
      match /payments/{paymentId} {
        allow read: if isStaff() ||
          (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.clientId == request.auth.uid);
        allow create: if isStaff() && isValidManualPayment(orderId);
        allow update, delete: if false;
      }
    }

    match /bookingRequests/{requestId} {
      allow read, update, delete: if isStaff();
      allow create: if isValidBookingRequest(request.resource.data);
    }

    match /portfolioItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

  }
}
